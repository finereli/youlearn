{
  "name": "youlearn",
  "compatibility_date": "2025-09-01",
  "account_id": "7485eb8ab648601f411b650cd794bce3",
  // The app is static; the Worker only answers /api and /ws: the parent's
  // remote control (worker/index.ts). SEED_FAMILY is a secret: the first
  // family, read once. SIGNUPS "open" lets anyone start a family, up to
  // SIGNUP_LIMIT new ones (counted in the Directory).
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/mcp", "/.well-known/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "FAMILY", "class_name": "Family" },
      { "name": "CODES", "class_name": "Codes" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // MCP agents and their tokens (worker/mcp.ts); schema in migrations/.
  "d1_databases": [{ "binding": "DB", "database_name": "youlearn", "database_id": "e4c44707-a200-4cbd-88bf-d73106f6639b" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family", "Codes", "Directory"] }],
  // Workers Logs: the Worker's console, including child devices' lines sent
  // to /api/client-log. Searchable in the dashboard for 3 days.
  "observability": { "enabled": true },
  "vars": { "SIGNUPS": "open", "SIGNUP_LIMIT": "100" },
  "routes": [{ "pattern": "youlearn.finereli.com", "custom_domain": true }]
}
